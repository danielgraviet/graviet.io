# Sanity CMS — leave blank to use placeholder data
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Revalidation secret for Sanity webhook (generate with: openssl rand -hex 32)
REVALIDATION_SECRET=

# Neon Postgres connection string, used by the /tools/roadmap concept tracker
DATABASE_URL=

# Household Budget — Plaid Transactions. Wells Fargo requires Production OAuth.
PLAID_CLIENT_ID=6a8131ac38c462000e00b1a5
PLAID_SECRET=69e464d49b62c6a0267e4d4ad400b5
PLAID_ENV=sandbox
# Use https://your-domain.com/tools/budget in Production and add it to Plaid's allowed redirect URIs.
PLAID_REDIRECT_URI=http://localhost:3000/tools/budget
# Generate with: openssl rand -base64 32
BUDGET_TOKEN_ENCRYPTION_KEY=Ybadkv8L/CZQE0ZZbLOy5eoWTL94+rqKtiE9F5xcvIY=

# Work-log auto-tagging — create a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TAGGING_MODEL=openai/gpt-oss-20b

# Daily Work Log automation. Local roots include unpushed commits only in local dev;
# Vercel uses the GitHub API token to search pushed commits across repositories.
WORK_LOG_REPO_ROOTS=/Users/you/Desktop/projects
WORK_LOG_GITHUB_ENABLED=true
WORK_LOG_GITHUB_AUTHOR=danielgraviet
WORK_LOG_GITHUB_TOKEN=
WORK_LOG_TIME_ZONE=America/Denver
WORK_LOG_AUTOMATION_HOUR=18
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
WORK_LOG_TELEGRAM_BOT_TOKEN=
WORK_LOG_TELEGRAM_CHAT_ID=
WORK_LOG_TELEGRAM_USER_ID=
WORK_LOG_TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
